{
  "name": "chordpro",
  "displayName": "ChordPro",
  "publisher": "ricardomfmsousa",
  "description": "Provides ChordPro support for Visual Studio Code",
  "author": {
    "name": "Ricardo Marques de Sousa"
  },
  "version": "0.3.0",
  "main": "./src/extension.js",
  "scripts": {
    "release:major": "scripts/./release.sh major",
    "release:minor": "scripts/./release.sh minor",
    "release:patch": "scripts/./release.sh patch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "license": "MIT",
  "icon": "images/chordpro.png",
  "keywords": [
    "chordpro",
    "chord",
    "music",
    "lyrics",
    "guitar",
    "songbook",
    "tabs"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardomfmsousa/vscode-chordpro.git"
  },
  "bugs": {
    "url": "https://github.com/ricardomfmsousa/vscode-chordpro/issues"
  },
  "homepage": "https://github.com/ricardomfmsousa/vscode-chordpro#readme",
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "chordpro.showPreview",
        "title": "Show Preview",
        "category": "ChordPro",
        "icon": "$(open-preview)"
      },
      {
        "command": "chordpro.exportPdf",
        "title": "Export to PDF",
        "category": "ChordPro",
        "icon": "$(file-pdf)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "chordpro.showPreview",
          "group": "navigation",
          "when": "resourceLangId == chordpro"
        }
      ]
    },
    "languages": [
      {
        "id": "chordpro",
        "aliases": [
          "ChordPro",
          "chordpro",
          "chord"
        ],
        "extensions": [
          ".cho",
          ".crd",
          ".chord",
          ".chopro",
          ".chordpro",
          ".pro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "chordpro",
        "scopeName": "text.chordpro",
        "path": "./syntaxes/chordpro.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[chordpro]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "snippets": [
      {
        "language": "chordpro",
        "path": "./snippets/chordpro.json"
      }
    ]
  },
  "dependencies": {
    "chordsheetjs": "^13.2.1"
  }
}
